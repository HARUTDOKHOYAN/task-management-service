# Copy to .env (next to docker-compose.yml) on the home server.

# MongoDB server URL. "mongo" = the MongoDB container from docker-compose.yml.
# For another MongoDB server: mongodb://user:password@host:27017
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=focus-list

APP_USER=me
APP_PASSWORD=change-me-to-a-long-password
# Port on the server for plain HTTP (without Caddy)
APP_PORT=3001
# For HTTPS with Caddy: your domain that points to your public IP
DOMAIN=tasks.example.com
