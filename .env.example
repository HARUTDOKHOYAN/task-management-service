# Copy this file to .env.local and set your values.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=focus-list
API_PORT=3001
# 127.0.0.1 = only this computer. 0.0.0.0 = other devices on your network too.
HOST=127.0.0.1

# Simple password. Empty = no password (OK only on your own computer).
APP_USER=me
APP_PASSWORD=
